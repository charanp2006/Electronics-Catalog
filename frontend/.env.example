# Frontend environment variables (Vite).
# Vite only exposes variables prefixed with VITE_, and they are inlined at BUILD time.
#
# Copy this file to `.env` to override locally. Not required for local dev — see below.

# Backend API base URL. MUST include the version prefix (/api/v1).
# Production (Netlify) — set this in the site's environment variables, then redeploy:
#   VITE_API_URL=https://electrohub-api-xxxx.onrender.com/api/v1
#
# Local dev — leave UNSET (or use the line below). When unset, the app calls the
# relative path `/api/v1`, which Vite's dev server proxies to http://localhost:8000.
# VITE_API_URL=http://localhost:8000/api/v1
